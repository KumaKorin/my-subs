{
    "name": "mysubs-clash-worker",
    "version": "1.0.0",
    "description": "Cloudflare Worker for Clash Subscription Management with WebUI and AES Encryption",
    "type": "module",
    "main": "src/worker.ts",
    "scripts": {
        "build:client": "esbuild src/client/app.ts src/client/login.ts --outdir=src/public/js --out-extension:.js=.client.js --bundle --format=esm --external:https://* --target=es2022",
        "build": "npm run build:client",
        "typecheck": "tsc --noEmit",
        "dev": "npm run build && wrangler dev",
        "deploy": "npm run build && wrangler deploy"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260823.1",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2",
        "wrangler": "^4.125.0"
    },
    "dependencies": {
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/theme-one-dark": "^6.1.3",
        "codemirror": "^6.0.2"
    }
}
